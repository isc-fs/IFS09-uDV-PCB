	(text "El SDC tiene que poder ser accionado por MicroDV y también tiene que poder ser \nleido por MicroDV para las comprobaciones de seguridad. \nIncorporamos un RELE que cierra el SDC solo cuando MicroDV suministra activamente la señal de control (3,3v)"
		(exclude_from_sim no)
		(at 14.224 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 132 0 1)
			)
			(justify left)
		)
		(uuid "7334f4cd-6766-4966-b4b9-79dcbf0c0dea")
	)
	(text "Conexión de CAN"
		(exclude_from_sim no)
		(at 112.014 215.138 0)
		(effects
			(font
				(size 1.27 1.27)
